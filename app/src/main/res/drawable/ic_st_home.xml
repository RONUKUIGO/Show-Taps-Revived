<?xml version="1.0" encoding="utf-8"?>
<!--
    主页 tab 图标（自绘）：一个「按下的触点」+ 两圈扩散，对应 Show Taps 的语义。
    24x24 viewport；描边用 stroke，方便跟着 tintColor 走。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 内圈实心触点 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,9.2a2.8,2.8 0 1,0 0.001,0z" />

    <!-- 内环 -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M12,6.1a5.9,5.9 0 1,0 0.001,0z" />

    <!-- 外弧（四段，做出扩散感） -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M4.4,12a7.6,7.6 0 0,1 3.1,-6.1" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M19.6,12a7.6,7.6 0 0,1 -3.1,6.1" />
</vector>
